{
    "name": "Gear Out",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "web",
    "workspaceFolder": "/var/www/html",
    "forwardPorts": [8080, 3306],
    "portsAttributes": {
        "8080": {
            "label": "Email registration system",
            "onAutoForward": "openPreview",
            "visibility": "public"
        }
    },
    "postCreateCommand": "echo \"Email reg system ready.\""
}